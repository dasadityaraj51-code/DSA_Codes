#include <stdio.h>

int main()
{
    int ch;

    printf("Enter 1 for Array, 2 for Linked list, 3 for Tree, 4 for Graph\n");
    scanf("%d", &ch);

    switch(ch)
    {
        case 1:
            printf("1. Non-Primitive  2. Linear  3. Static");
            break;

        case 2:
            printf("1. Non-Primitive  2. Linear  3. Dynamic");
            break;

        case 3:
            printf("1. Non-Primitive  2. Non-Linear");
            break;

        case 4:
            printf("1. Non-Primitive  2. Non-Linear");
            break;

        default:
            printf("Enter valid choice");
    }

    return 0;
}
