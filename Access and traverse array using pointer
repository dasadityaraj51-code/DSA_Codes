#include <stdio.h>

void access(int arr, int n)
{
    int i;

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", arr + i);
    }
}

void traverse(int *arr, int n)
{
    int i;

    printf("Array Elements : ");

    for (i = 0; i < n; i++)
    {
        printf("%d ", *(arr + i));
    }
}
