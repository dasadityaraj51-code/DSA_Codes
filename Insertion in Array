#include <stdio.h>

void insert(int arr[], int s, int n, int pos)
{
    for (int i = n; i > pos; i--)
    {
        arr[i] = arr[i - 1];
    }

    arr[pos] = s;
}

void print(int arr[], int s)
{
    for (int i = 0; i < s; i++)
    {
        printf("%d ", arr[i]);
    }
}

int main()
{
    int arr[] = {10, 20, 30, 40};
    int s = 4;

    insert(arr, 25, s, 2);
    s++;

    printf("Array after insertion: ");
    print(arr, s);

    return 0;
}
